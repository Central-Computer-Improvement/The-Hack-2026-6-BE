# Database Configuration (MySQL / XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=auralearn_db

# Express Server Configuration
PORT=5000

# Google OAuth (Optional / Auth)
GOOGLE_CLIENT_ID=
#Cara dapetin Client ID-nya:
# Buka Google Cloud Console → pilih/buat project
# Menu APIs & Services → Credentials
# Create Credentials → OAuth client ID
# Application type: Web application
# Setelah dibuat, copy Client ID-nya (bentuknya kayak xxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com)
# Tempel ke .env:
# GOOGLE_CLIENT_ID=xxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# DeepTutor AI Microservice Configuration
DEEPTUTOR_API_URL=http://127.0.0.1:8001/api/v1
DEEPTUTOR_WS_URL=ws://127.0.0.1:8001/api/v1/ws
DEEPTUTOR_AUTH_TOKEN=

